# Selected only when DJANGO_ENV=production is set before Django starts.
DJANGO_DEBUG=false
# Supply two distinct random secrets (at least 50 characters) through your secret manager.
DJANGO_SECRET_KEY=
PHONE_OTP_SECRET=
# Fill in your actual hostname when hosting is available. No scheme or port.
DJANGO_ALLOWED_HOSTS=
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_NUM_PROXIES=0
DJANGO_HSTS_SECONDS=3600
DJANGO_CSRF_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
DB_NAME=inventory_db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SMS_BACKEND=accounts.sms_service.twilio_send_sms
PHONE_OTP_BACKEND=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Run process_delivery_jobs --watch under a supervisor for recovery in either mode.
OUTBOX_INLINE_DISPATCH=true
